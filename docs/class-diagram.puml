@startuml class-diagram
' Adventure Booking System — Class Diagram (matches the code in src/)
' Team ID: 3
' Saksham 20251501153 | Prerna 20251501135 | Naitik 20251501133
' Kush 20251501176 | Abhay 20251502033
'
' Visibility:  - private   # protected   + public
' (~ package is not used: C++ has no package access)
' {static} = static member (underlined)   {abstract} = pure virtual (italic)
' Simple getters (getName(), getTitle(), ...) are left out to keep it readable.

skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

title Adventure Booking System — Class Diagram

' ============================ SYSTEM ============================

class BookingSystem {
  - today : String
  - nextUserNumber : int
  --
  + login(email : String, password : String) : User
  + checkNewTraveler(name : String, email : String, password : String, dob : String, fitness : int) : String
  + registerTraveler(name : String, email : String, password : String, phone : String, contact : EmergencyContact, dob : String, blood : String, fitness : FitnessLevel) : Traveler
  + searchUsers(keyword : String) : User[]
  + addTrip(trip : Trip) : Trip
  + findTrip(tripId : String) : Trip
  + openTrips() : Trip[]
  + searchTrips(keyword : String) : Trip[]
  + tripsOf(provider : AdventureProvider) : Trip[]
  + isOpenForBooking(trip : Trip) : bool
  + bookTrip(traveler : Traveler, trip : Trip, seats : int, cardNo : String, expiry : String) : Booking
  + cancelBooking(traveler : Traveler, booking : Booking) : bool
  + findBooking(bookingId : String) : Booking
  + bookingsForTrip(trip : Trip) : Booking[]
  + notifyTravelers(trip : Trip, message : String) : void
  + loadSampleData() : void
}

interface Searchable {
  + {abstract} matches(keyword : String) : bool
}

' ============================ USERS ============================

abstract class User {
  - userId : String
  - name : String
  - email : String
  - password : String
  - phone : String
  - {static} totalUsers : int
  # {static} showConstructorCalls : bool
  --
  + login(email : String, password : String) : bool
  + updateProfile(newName : String, newPhone : String) : void
  + matches(keyword : String) : bool
  + {abstract} getRole() : String
  + {abstract} showMenu(system : BookingSystem) : void
  + {static} getTotalUsers() : int
  # validatePassword(raw : String) : bool
  # {static} traceConstructor(className : String) : void
}

class Traveler {
  - dateOfBirth : String
  - bloodGroup : String
  - fitnessLevel : FitnessLevel
  --
  + maxSeatsPerBooking() : int
  + canBook(trip : Trip, seats : int) : bool
  + bookTrip(trip : Trip, seats : int, gateway : PaymentGateway, cardNo : String, expiry : String, today : String) : Booking
  + cancelBooking(booking : Booking, gateway : PaymentGateway, today : String) : bool
  + viewMyBookings(onlyConfirmed : bool = false) : void
  + getEmergencyContact() : EmergencyContact
  + getRole() : String
  + showMenu(system : BookingSystem) : void
}

class "Traveler::EmergencyContact" as EmergencyContact <<nested>> {
  - name : String
  - phone : String
  --
  + EmergencyContact(name : String = ~"~", phone : String = ~"~")
}

class AdventureProvider {
  - agencyName : String
  - licenseNumber : String
  - certification : String
  - rating : double
  - isVerified : bool
  --
  + createTrip(title : String, location : String, price : double, start : String, end : String, cap : int, minAge : int, fit : FitnessLevel) : Trip
  + publishTrip(t : Trip) : void
  + removeTrip(trip : Trip) : bool
  + getRole() : String
  + showMenu(system : BookingSystem) : void
}

class Admin {
  + viewAllUsers(users : User[]) : void
  + viewAllBookings(bookings : Booking[]) : void
  + tripReport(trips : Trip[], bookings : Booking[]) : void
  + removeTrip(trip : Trip) : bool
  + settlePendingRefund(payment : Payment, gateway : PaymentGateway) : bool
  + getRole() : String
  + showMenu(system : BookingSystem) : void
}

class SuperAdmin <<final>> {
  - companyName : String
  --
  + viewSystemStats(password : String) : void
  + getRole() : String
  + showMenu(system : BookingSystem) : void
}

class TravelerProvider <<final>> {
  + maxSeatsPerBooking() : int
  + getRole() : String
  + showMenu(system : BookingSystem) : void
}

' ============================ TRIPS & BOOKINGS ============================

class Trip {
  - tripId : String
  - providerId : String
  - title : String
  - location : String
  - price : double
  - startDate : String
  - endDate : String
  - maxCapacity : int
  - availableSlots : int
  - minAge : int
  - requiredFitness : FitnessLevel
  - status : TripStatus
  - {static} tripCount : int
  --
  + Trip()
  + Trip(title : String, location : String, price : double, start : String, end : String, cap : int, minAge : int, fit : FitnessLevel)
  + checkDetails(today : String) : String
  + reserveSlots(count : int) : bool
  + releaseSlots(count : int) : void
  + publish() : void
  + close() : void
  + changePrice(newPrice : double) : void
  + changeDates(newStart : String, newEnd : String) : void
  + canBeRemoved() : bool
  + matches(keyword : String) : bool
  + printRow() : void
  + {static} getTripCount() : int
  + operator++() : Trip
  + operator<(other : Trip) : bool
  - hasCapacityFor(count : int) : bool
  - assignNewId() : void
}

class Booking {
  - bookingId : String
  - bookingDate : String
  - seatsBooked : int
  - totalCost : double
  - status : BookingStatus
  - {static} bookingCount : int
  --
  + calculateTotalCost() : double
  + cancel(gateway : PaymentGateway, today : String) : bool
  + getStatus() : BookingStatus
  + getPayment() : Payment
  + {static} getBookingCount() : int
  - triggerEmail(message : String) : void
}

class Payment {
  - paymentId : String
  - amount : double
  - status : PaymentStatus
  - timestamp : String
  - {static} paymentCount : int
  --
  + Payment(amount : double, timestamp : String = "N/A")
  + operator double() : double
  + processPayment(gateway : PaymentGateway, cardNo : String, expiry : String) : PaymentStatus
  + processRefund(gateway : PaymentGateway) : PaymentStatus
  + getStatus() : PaymentStatus
  + {static} getPaymentCount() : int
}

class PaymentGateway <<simulated>> {
  - gatewayName : String
  - failMode : bool
  --
  + setFailMode(failMode : bool) : void
  + isFailing() : bool
  + validateDetails(cardNo : String, expiry : String) : bool
  + processTransaction(amount : double) : PaymentStatus
  + processRefund(amount : double) : PaymentStatus
}

class Receipt {
  - bookingId : String
  - travelerName : String
  - tripTitle : String
  - seats : int
  - amountPaid : double
  --
  + Receipt(b : Booking)
}

' ============================ ENUMS ============================

enum FitnessLevel {
  LOW
  MODERATE
  HIGH
}

enum TripStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

' ============================ RELATIONSHIPS ============================

' Realization (dashed line, hollow triangle): the class follows the interface
Searchable <|.. User
Searchable <|.. Trip

' Generalization (inheritance)
User <|-- Traveler : <<virtual>>
User <|-- AdventureProvider : <<virtual>>
User <|-- Admin
Admin <|-- SuperAdmin
Traveler <|-- TravelerProvider
AdventureProvider <|-- TravelerProvider

' Composition (filled diamond): the part lives and dies with the whole
BookingSystem *-- "1" PaymentGateway : has >
BookingSystem *-- "0..*" User : owns >
BookingSystem *-- "0..*" Trip : owns >
BookingSystem *-- "0..*" Booking : owns >
Traveler *-- "1" EmergencyContact : has >
Booking "1" *-- "1" Payment : paid by >

' Aggregation (hollow diamond): Traveler keeps pointers to its bookings,
' but does not own them (the BookingSystem does)
Traveler "1" o-- "0..*" Booking : makes >

' Association with multiplicity
Booking "0..*" --> "1" Trip : for >

' Dependency (dashed arrow): uses the other class, does not store it
AdventureProvider ..> Trip : <<create>>
Payment ..> PaymentGateway : uses >
Receipt ..> Booking : made from >
Admin ..> Trip : <<friend>>

' Enums used as attribute types
Trip ..> FitnessLevel
Trip ..> TripStatus
Booking ..> BookingStatus
Payment ..> PaymentStatus

' ============================ NOTES ============================

note top of User
  **Abstract class:** getRole() and showMenu()
  are pure virtual (= 0), so no plain User
  object can be created.
  After login, user->showMenu() opens a
  different menu for each kind of user.
end note

note bottom of TravelerProvider
  **Diamond problem:** User is reached through
  Traveler AND AdventureProvider. Both inherit
  User **virtually**, so TravelerProvider has
  only ONE User part.
end note

note bottom of Trip
  **Friend functions** (not members, so not listed above):
  operator<< and operator>> (input/output),
  operator== (compares two trips by tripId).
  Every class also has a friend operator<<.
end note

@enduml
