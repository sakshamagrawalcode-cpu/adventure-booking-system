@startuml use-case-diagram
' Adventure Booking System — Use Case Diagram

left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 14
skinparam ranksep 70

actor "Traveler" as T
actor "Adventure Provider" as P
actor "Admin" as A

actor "Payment Gateway" as PG
actor "Email Service" as ES

rectangle "Adventure Booking System" {

  usecase "Register / Login"          as UC1
  usecase "Browse Adventures"         as UC2
  usecase "Book Adventure"            as UC3
  usecase "Cancel Booking"            as UC4
  usecase "View My Bookings"          as UC5
  usecase "Manage Trips"              as UC6
  usecase "View Trip Bookings"        as UC7
  usecase "Manage Users and Listings" as UC8
  usecase "Make Payment"              as UC9
  usecase "Send Confirmation Email"   as UC10
  usecase "Notify Booked Travelers"   as UC11

  UC3 ..> UC9  : <<include>>
  UC3 ..> UC10 : <<include>>
  UC4 ..> UC10 : <<include>>

  UC11 ..> UC10 : <<include>>
  UC11 ..> UC6 : <<extend>>\n[trip already has bookings]
}

T -- UC1
T -- UC2
T -- UC3
T -- UC4
T -- UC5

P -- UC1
P -- UC6
P -- UC7

A -- UC1
A -- UC8

UC9  -- PG
UC10 -- ES

@enduml
